    {
      "parameters": {
        "jsCode": "const aiText = $json.output[0].content[0].text;\nconst aiResult = JSON.parse(aiText);\n\nconst lead = $('Webhook').first().json.body;\n\n// Calculate score ourselves\nconst lead_score =\n  Number(aiResult.budget_points) +\n  Number(aiResult.requirement_points) +\n  Number(aiResult.timeline_points) +\n  Number(aiResult.business_value_points) +\n  Number(aiResult.service_fit_points);\n\n// Determine temperature from score\nlet lead_temperature;\n\nif (lead_score >= 80) {\n  lead_temperature = \"HOT\";\n} else if (lead_score >= 50) {\n  lead_temperature = \"WARM\";\n} else {\n  lead_temperature = \"COLD\";\n}\n\n// Determine priority\nlet priority;\n\nif (lead_temperature === \"HOT\") {\n  priority = \"HIGH\";\n} else if (lead_temperature === \"WARM\") {\n  priority = \"MEDIUM\";\n} else {\n  priority = \"LOW\";\n}\n\nreturn [\n  {\n    json: {\n      lead_id: \"LEAD-\" + Date.now(),\n\n      name: lead.name,\n      email: lead.email,\n      company: lead.company,\n      phone: lead.phone,\n      requirement: lead.requirement,\n      budget: lead.budget,\n      timeline: lead.timeline,\n      lead_source: lead.source,\n\n      lead_score: lead_score,\n      lead_temperature: lead_temperature,\n      priority: priority,\n\n      ai_reason: aiResult.ai_reason,\n      recommended_action: aiResult.recommended_action,\n\n      email_status: \"Pending\",\n      created_at: new Date().toISOString()\n    }\n  }\n];"
      },
